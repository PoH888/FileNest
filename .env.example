# 从项目根目录启动时，使用本地 SQLite 数据库。
FILENEST_DATABASE_URL=sqlite:///./backend/filenest.db

# 真实模型调用所需配置。请使用本地环境变量或部署平台注入真实密钥，
# 不要把真实 API 密钥写入仓库。
FILENEST_MODEL_PROVIDER=example-provider
FILENEST_MODEL_NAME=example-model
FILENEST_MODEL_API_KEY=replace-with-a-local-secret

# 真实 Retrieval Evaluation 使用的 Embedding 配置。
FILENEST_EMBEDDING_PROVIDER=openai
FILENEST_EMBEDDING_MODEL=text-embedding-3-small
FILENEST_EMBEDDING_API_KEY=replace-with-a-local-secret
